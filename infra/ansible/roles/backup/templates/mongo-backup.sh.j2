#!/usr/bin/env bash
# Backup lógico do banco todo-app -> arquivo local + S3.
# Uso: mongo-backup.sh [rótulo]   (gerenciado pelo Ansible)
set -euo pipefail

LABEL="${1:-manual}"
TS="$(date -u +%Y%m%dT%H%M%SZ)"
NAME="todo-app-${TS}-${LABEL}.archive.gz"
LOCAL_DIR=/var/backups/mongo
S3_URI="s3://{{ backup_bucket }}/{{ backup_prefix }}/${NAME}"

echo "[$(date -Is)] Iniciando backup ${NAME}"

# mongodump dentro do contêiner; credenciais lidas das variáveis do contêiner
docker exec {{ mongo_container | default('mongo') }} sh -c \
  'mongodump --quiet -u "$MONGO_INITDB_ROOT_USERNAME" -p "$MONGO_INITDB_ROOT_PASSWORD" \
   --authenticationDatabase admin --db "$MONGO_INITDB_DATABASE" --archive --gzip' \
  > "${LOCAL_DIR}/${NAME}"

COUNT="$(docker exec {{ mongo_container | default('mongo') }} sh -c \
  'mongosh --quiet -u "$MONGO_INITDB_ROOT_USERNAME" -p "$MONGO_INITDB_ROOT_PASSWORD" \
   --authenticationDatabase admin --eval "db.getSiblingDB(process.env.MONGO_INITDB_DATABASE).todos.countDocuments()"')"
SIZE="$(stat -c %s "${LOCAL_DIR}/${NAME}")"

# Envio ao S3 usando a IAM role da instância (sem chave gravada na VM)
docker run --rm -v "${LOCAL_DIR}:/backup:ro" -e AWS_DEFAULT_REGION={{ aws_region }} \
  {{ awscli_image }} s3 cp "/backup/${NAME}" "${S3_URI}" \
  --metadata "todos=${COUNT}" --only-show-errors

# Mantém somente os últimos {{ backup_local_keep }} arquivos locais
ls -1t "${LOCAL_DIR}"/todo-app-*.archive.gz | tail -n +$(( {{ backup_local_keep }} + 1 )) | xargs -r rm -f

echo "[$(date -Is)] Backup concluído: ${S3_URI} (${SIZE} bytes, ${COUNT} tarefas)"
